# ---------- Docker Compose ----------
# Cartella principale del NAS sul server (una sola; le sottocartelle da mostrare e quella per gli upload
# si scelgono dalla dashboard, pagina "Cartelle"). Montata via NFS, es. in /etc/fstab:
#   nas.local:/volume1/film  /mnt/filmshare  nfs4  rw,hard,_netdev  0 0
# L'utente del container (uid 1000) deve poter scrivere qui.
SHARED_DIR=/mnt/filmshare

# Porta su cui risponde la dashboard
WEB_PORT=8080

# true se davanti c'è HTTPS (consigliato su internet)
COOKIE_SECURE=false

# Fuso orario per i periodi delle quote (giorno, settimana da lunedì, mese)
TZ=Europe/Rome

# Dimensione massima di un file caricato, in GB
MAX_FILE_GB=200

# Indirizzo di contatto per le notifiche push (richiesto dal protocollo)
PUSH_SUBJECT=mailto:admin@filmshare.local

# Facoltativi: se vuoti vengono generati alla prima partenza e salvati nel database
LINK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- Sviluppo (npm run dev) ----------
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/filmshare.db
SHARED_PATH=./data/condivisi
UPLOAD_TMP_PATH=./data/condivisi/.upload-in-corso
